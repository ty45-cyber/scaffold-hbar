{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_HEDERA_NETWORK",
        "NEXT_PUBLIC_HEDERA_ACCOUNT_ID",
        "NEXT_PUBLIC_HASHIO_RPC_URL",
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
        "HEDERA_TESTNET_PRIVATE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}
